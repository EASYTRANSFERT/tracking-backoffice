# false = authentification réelle ; true = handlers MSW de développement
VITE_ENABLE_MOCKS=false

# Production : URL complète de l'API.
VITE_API_BASE_URL=https://your-api.example.com/api/v1

# Développement avec un tunnel (ngrok, Cloudflare…) : passer par le proxy de Vite.
#   VITE_API_BASE_URL=/api/v1
#   VITE_API_PROXY_TARGET=https://xxxx.ngrok-free.dev
# Le navigateur appelle alors localhost:5173/api/v1, Vite relaie vers le tunnel :
# plus d'erreur CORS. Redémarrer « npm run dev » après chaque changement.
